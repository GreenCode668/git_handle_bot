# --- Required -------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Your numeric Telegram user id (e.g. from @userinfobot). All other users are ignored.
TELEGRAM_ALLOWED_USER_ID=123456789
# GitHub personal access token (classic recommended; scopes: repo, delete_repo, user, workflow)
GITHUB_TOKEN=ghp_replace_me
GITHUB_USERNAME=your-github-username
# Commit identity used when rewriting authors (optional; the name defaults to the username)
# GITHUB_EMAIL=you@example.com
# GITHUB_NAME=Your Name
# Where git mirror backups are stored. Use a disk with enough free space.
BACKUP_PATH=./backups

# --- Code review & fix (/review) -------------------------------------------
# Path to the Claude Code CLI used to generate fixes (install: curl -fsSL https://claude.ai/install.sh | bash)
# CLAUDE_CODE_PATH=claude
# Hard timeout for one fix run, milliseconds (default 300000 = 5 min)
# REVIEW_TIMEOUT_MS=300000
# Maximum files a single fix run may touch (default 10)
# MAX_FILES_PER_FIX=10
# Where review clones are made (default: a folder inside WORK_PATH)
# TEMP_DIR=/tmp/ghbot-review

# --- Optional -------------------------------------------------------------
# Show private repositories in READ-ONLY views (default false = hidden completely).
# Private repositories are never modified, regardless of this setting.
# SHOW_PRIVATE_REPOS=false
# DATABASE_PATH=./data/bot.db
# WORK_PATH=./backups/.work
# LOG_LEVEL=INFO
# Maximum seconds for a single git command (clone/push)
# GIT_TIMEOUT=3600
